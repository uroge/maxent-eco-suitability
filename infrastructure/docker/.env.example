# Docker Compose local-development configuration. Do not use these credentials in production.
NEXT_PUBLIC_API_URL=http://localhost:3001
CLIENT_BRAND=
REDIS_URL=redis://redis:6379
REDIS_DURABILITY_MODE=required
STORAGE_BUCKET=ecosuitability
STORAGE_ACCESS_KEY_ID=local-storage-access-key
STORAGE_SECRET_ACCESS_KEY=local-storage-secret-key
STORAGE_CORS_ORIGINS=http://localhost:3000
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=172.16.0.0/12
METRICS_TOKEN=replace-with-a-random-32-character-minimum-token
WORKER_METRICS_TOKEN=replace-with-a-random-32-character-minimum-token
MAX_JSON_BODY_BYTES=1048576
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
