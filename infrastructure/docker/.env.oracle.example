# Backend-only Oracle deployment. Copy to .env.oracle and replace every placeholder.
APP_ENV=staging
CADDY_EMAIL=owner@example.com
API_DOMAIN=api-dev.example.com

# Required during Compose interpolation even though the remote web profile is disabled.
NEXT_PUBLIC_API_URL=https://api-dev.example.com
CLIENT_BRAND=

REDIS_URL=redis://redis:6379
REDIS_DURABILITY_MODE=required

STORAGE_BUCKET=ecosuitability-dev
STORAGE_INTERNAL_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
STORAGE_PRESIGN_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
# Hostname only, without https://. GDAL uses this value to read COGs from R2.
STORAGE_S3_ENDPOINT_HOST=replace-with-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
STORAGE_CORS_ORIGINS=http://localhost:3000

# Use the same Clerk development instance as the local frontend.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000

METRICS_TOKEN=replace-with-a-random-32-byte-minimum-secret
WORKER_METRICS_TOKEN=replace-with-a-random-32-byte-minimum-secret
R_RUNTIME_SHARED_SECRET=replace-with-a-random-32-byte-minimum-secret
TILE_INTERNAL_SHARED_SECRET=replace-with-a-random-32-byte-minimum-secret

MAX_JSON_BODY_BYTES=1048576
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
ANALYSIS_EXECUTION_TIMEOUT_MS=1800000
R_RUNTIME_HTTP_TIMEOUT_MS=10000
R_RUNTIME_RUN_TIMEOUT_MS=1800000
R_RUNTIME_INPUT_URL_TTL_SECONDS=900
R_RUNTIME_OUTPUT_URL_TTL_SECONDS=900
R_RUNTIME_WORKSPACE_QUOTA_BYTES=6442450944
R_RUNTIME_CHILD_MEMORY_BYTES=2147483648
TILE_REQUEST_TIMEOUT_MS=5000
TILE_RESPONSE_MAX_BYTES=2097152

# Basemap styles are optional. A style URL must always be paired with attribution.
MAP_LIGHT_STYLE_URL=
MAP_DARK_STYLE_URL=
MAP_LIGHT_ATTRIBUTION=
MAP_SATELLITE_STYLE_URL=
MAP_SATELLITE_ATTRIBUTION=
MAP_TERRAIN_STYLE_URL=
MAP_TERRAIN_ATTRIBUTION=
