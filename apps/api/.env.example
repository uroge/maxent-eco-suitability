APP_ENV=development
PORT=3001
MAX_JSON_BODY_BYTES=1048576
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
STORAGE_PROVIDER=seaweedfs
STORAGE_INTERNAL_ENDPOINT=http://localhost:8333
STORAGE_PRESIGN_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=ecosuitability
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
METRICS_TOKEN=replace-with-a-random-32-character-minimum-token
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
