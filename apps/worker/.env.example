APP_ENV=development
REDIS_URL=redis://localhost:6379
STORAGE_INTERNAL_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ecosuitability
STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
WORKER_OPERATIONS_PORT=9464
WORKER_METRICS_TOKEN=replace-with-a-random-32-character-minimum-token
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
ANALYSIS_EXECUTION_TIMEOUT_MS=1800000
