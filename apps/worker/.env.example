APP_ENV=development
REDIS_URL=redis://localhost:6379
STORAGE_INTERNAL_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ecosuitability
STORAGE_ACCESS_KEY_ID=local-storage-access-key
STORAGE_SECRET_ACCESS_KEY=local-storage-secret-key
STORAGE_FORCE_PATH_STYLE=true
WORKER_OPERATIONS_PORT=9464
WORKER_METRICS_TOKEN=replace-with-a-random-32-character-minimum-token
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
ANALYSIS_EXECUTION_TIMEOUT_MS=1800000
R_RUNTIME_URL=http://localhost:8080
R_RUNTIME_SHARED_SECRET=replace-with-a-random-32-byte-minimum-secret
R_RUNTIME_HTTP_TIMEOUT_MS=10000
R_RUNTIME_RUN_TIMEOUT_MS=1800000
R_RUNTIME_INPUT_URL_TTL_SECONDS=900
R_RUNTIME_OUTPUT_URL_TTL_SECONDS=900
