{
  "name": "ecosuitability",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo clean && rimraf node_modules",
    "docker:build": "docker compose -f infrastructure/docker/compose.yaml build",
    "docker:up": "docker compose -f infrastructure/docker/compose.yaml up --build",
    "docker:down": "docker compose -f infrastructure/docker/compose.yaml down --remove-orphans"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@turbo/gen": "2.10.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
